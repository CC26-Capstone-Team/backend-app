{
	"name": "backend-app",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"dev": "tsx watch server.ts",
		"build": "eslint . && tsc",
		"start": "node dist/server.js",
		"db:migrate": "prisma migrate dev",
		"db:migrate:prod": "prisma migrate deploy",
		"db:generate": "prisma generate",
		"db:studio": "prisma studio",
		"db:seed": "tsx src/database/seeders/seed.ts",
		"db:reset": "prisma migrate reset"
	},
	"dependencies": {
		"@google/genai": "^2.6.0",
		"@prisma/adapter-pg": "^7.6.0",
		"@prisma/client": "^7.6.0",
		"axios": "^1.14.0",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.0",
		"dotenv-expand": "^12.0.3",
		"express": "^5.2.1",
		"google-auth-library": "^10.6.2",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.1.1",
		"serpapi": "^2.2.1",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.19.0",
		"zod": "^4.3.6",
		"zod-openapi": "^5.4.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.1.0",
		"@types/node": "^25.5.0",
		"@types/swagger-ui-express": "^4.1.8",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.1",
		"prisma": "^7.6.0",
		"ts-node-dev": "^2.0.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0"
	}
}
