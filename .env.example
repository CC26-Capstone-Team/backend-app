# Server
PORT=4000
NODE_ENV=development

# Database
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
# URL publik backend (wajib diisi di VPS agar URL avatar menggunakan https)
# Contoh: https://backendcapstone.sayadewe.my.id
BACKEND_URL=http://localhost:5000

# Gemini API
GEMINI_API_KEY=

# SerpAPI Key
SERPAPI_API_KEY=

# Oauth Secret
GOOGLE_CLIENT_ID=

# ML API
ML_API_URL=
